# ==============================================================================
# PROJECT HADES - CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e ajuste conforme necessário:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REDE & SERVIDORES (IPs, Hosts e Portas)
# ------------------------------------------------------------------------------
# Host ou IP principal onde os servidores estão rodando (ex: 127.0.0.1, 192.168.1.50, IP público GCP)
HADES_SERVER_HOST=127.0.0.1

# Endereço completo do Hades World Server para conexão de clientes
HADES_WORLD_SERVER=127.0.0.1:4434

# Portas de escuta
HADES_WORLD_PORT=4434
HADES_LOGIN_PORT=4433
HADES_WS_LOGIN_PORT=4432

# Binds dos servidores (0.0.0.0 escuta em todas as placas de rede/interfaces)
HADES_BIND=0.0.0.0:4433
HADES_WS_BIND=0.0.0.0:4432
HADES_WORLD_BIND=0.0.0.0:4434
HADES_WORLD_QUIC_BIND=0.0.0.0:4434

# IP anunciado pelo Login Server para redirecionar clientes ao World Server
HADES_WORLD_IP=127.0.0.1
HADES_WORLD_NAME="Hades Midgard"

# Nomes alternativos (SAN) aceitos pelo certificado TLS 1.3 autoassinado
# Separe múltiplos por vírgula se for rodar em LAN ou IP externo: ex: "192.168.0.10,hades.local"
HADES_TLS_SAN=127.0.0.1,localhost
HADES_SERVER_SNI=localhost

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS
# ------------------------------------------------------------------------------
# Conexão SQLite em arquivo local ou em memória
HADES_DB_URL="sqlite://hades_login.db?mode=rwc"

# ------------------------------------------------------------------------------
# 3. CREDENCIAIS & AUTENTICAÇÃO (Sem hardcodes)
# ------------------------------------------------------------------------------
# Conta de desenvolvimento padrão criada pelo Login Server
HADES_DEV_ACCOUNT_USER=admin
HADES_DEV_ACCOUNT_PASSWORD=admin
# Opcional: SHA-256 hex pré-calculado da senha dev (se não fornecido, é gerado automaticamente)
# HADES_DEV_ACCOUNT_PASS_HASH=<hash_sha256_opcional>
HADES_DEV_CHAR_NAME=Berenice

# Credenciais usadas pelo cliente Berenice para login automático ou pré-preenchimento
HADES_AUTH_USER=admin
HADES_AUTH_PASSWORD=admin
HADES_AUTO_LOGIN=false

# IDs de entidade e autorização da sessão de jogo
HADES_CLIENT_AID=1
HADES_CLIENT_GID=1
HADES_CLIENT_AUTH_CODE=42
HADES_CLIENT_CHAR_NAME=Berenice

# ------------------------------------------------------------------------------
# 4. MUNDO, MAPA & SPAWN
# ------------------------------------------------------------------------------
# Nome do mapa inicial (.gat) e coordenadas de spawn
HADES_MAP_NAME=prontera.gat
HADES_SPAWN_X=156
HADES_SPAWN_Y=180

# ------------------------------------------------------------------------------
# 5. ASSETS & VFS (.grf, áudio e modelos)
# ------------------------------------------------------------------------------
# Caminho para o arquivo principal de dados do jogo (.grf)
HADES_GRF_PATH=data.grf

# Arquivos opcionais secundários de eventos ou áudio
HADES_EVENT_GRF_PATH=event.grf
HADES_BGM_PATH=BGM/01.mp3

# ------------------------------------------------------------------------------
# 6. JANELA & RENDERIZAÇÃO (Berenice Client)
# ------------------------------------------------------------------------------
HADES_WINDOW_WIDTH=800
HADES_WINDOW_HEIGHT=600

# Ativação do layout vertical para Tiling Window Managers (Hyprland / Omarchy)
HADES_VERTICAL=false
HADES_OMARCHY=false

# ------------------------------------------------------------------------------
# 7. STYX - SIMULAÇÃO DE REDE (Latência / Jitter / Perda)
# ------------------------------------------------------------------------------
# Perfis disponíveis: disabled, fibra, cidade, movel, rural, low_orbit, estacionario, apocalipse
STYX_PROFILE=disabled

# ------------------------------------------------------------------------------
# 8. LOGS & TELEMETRIA
# ------------------------------------------------------------------------------
HADES_VERBOSE=false
RUST_LOG="info,hades_login=debug,hades_world=info,hades_net=info,berenice=info"
